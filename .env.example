# Desarrollo local -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=.localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biolife
BASE_DOMAIN=localhost
TIME_ZONE=America/Caracas

# Producción (Railway, Fase 17) --------------------------------------------------------
# Se cargan como variables del servicio en Railway, NO en un archivo .env.
#
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<generar uno nuevo, distinto al de desarrollo>
# DEBUG=False
# BASE_DOMAIN=midominio.com
# ALLOWED_HOSTS=.midominio.com          <- el punto inicial cubre los subdominios
# DATABASE_URL=${{Postgres.DATABASE_URL}}   <- referencia al servicio de Railway
# CLOUDINARY_URL=cloudinary://<clave>:<secreto>@<nube>
# SENTRY_DSN=<opcional; vacío desactiva el envío de errores>
